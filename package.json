{
  "name": "weread",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vite-node tests/encoding.test.mjs && vite-node tests/pagination.test.mjs && vite-node tests/reading-time.test.mjs && vite-node tests/epub.test.mjs && vite-node tests/import.test.mjs && vite-node tests/progress.test.mjs && vite-node tests/db.test.mjs && vite-node tests/library.test.mjs && vite-node tests/ui-state.test.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test:e2e": "node tests/e2e.browser.mjs && node tests/tabbar.browser.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "jszip": "^3.10.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vue-tsc": "^3.3.13"
  }
}
