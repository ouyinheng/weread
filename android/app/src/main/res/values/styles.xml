<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Colours are literal: there is no colors.xml in
         this project, and a dangling @color/ reference fails the build. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#1b88ee</item>
        <item name="colorPrimaryDark">#1b88ee</item>
        <item name="colorAccent">#1b88ee</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Transparent bars so the WebView paints the page colour edge to edge.
             An opaque window background here is what produced the white band
             under the tab bar on gesture navigation. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
