<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Colours are literal: there is no colors.xml in
         this project, and a dangling @color/ reference fails the build. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#3e6bf0</item>
        <item name="colorPrimaryDark">#3e6bf0</item>
        <item name="colorAccent">#3e6bf0</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Transparent bars so the WebView paints the page colour edge to edge.
             An opaque window background here is what produced the white band
             under the tab bar on gesture navigation. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!--
      Launch theme.

      Two completely different splash mechanisms live here, and only setting
      one of them is why the designed splash "did not take":

      - Android 12+ draws its own splash from `windowSplashScreenBackground` +
        `windowSplashScreenAnimatedIcon` and **ignores `android:background`**.
        With neither attribute set it fell back to a plain window colour, so the
        phone showed a blank screen instead of the artwork.
      - Android 11 and below paint the window with `android:background`, which
        is the full-bleed splash bitmap.

      `postSplashScreenTheme` hands the activity over to the real theme once the
      splash is done; without it the activity would keep a splash theme forever.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
